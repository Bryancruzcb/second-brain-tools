# Absolute path to the Obsidian vault used by the parser, note tools, and indexer.
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault

# Absolute path to the ChromaDB persistence directory used by the backend's
# vector index. Defaults to backend/chroma_db (next to backend/config.py) if unset.
# CHROMA_DB_PATH=/Users/you/second-brain-tools/backend/chroma_db

# Ollama model used for chat and co-writing. Defaults to qwen2.5.
# OLLAMA_MODEL=qwen2.5

# Base URL of the local Ollama server. Defaults to http://localhost:11434.
# OLLAMA_URL=http://localhost:11434

# Context window per chat call. Defaults to 16384 so eight retrieved chunks
# plus conversation history and a 1K answer fit (Ollama's own default is
# ~4K and silently truncates long prompts from the top).
# OLLAMA_NUM_CTX=16384

# Retrieval knobs. The defaults are the configuration measured on 2026-09-04
# and promoted 2026-09-07 (README, "Retrieval quality"): each leg fetches 30
# candidates, the fused top 30 is reranked, and eight chunks go to Qwen.
# TOP_K=6 still fits OLLAMA_NUM_CTX=8192 if you prefer the smaller window.
# TOP_K=8
# HYBRID_DEPTH=30
# RERANK_DEPTH=30
# Chunks one note may occupy in the served list; 0 disables the cap. Without
# it a bigger TOP_K mostly shows more chunks of the same long notes.
# MAX_CHUNKS_PER_NOTE=1

# Cross-encoder defaults to the Xenova int8 ONNX export (same weights as
# cross-encoder/ms-marco-MiniLM-L-6-v2, ~0.9 s vs ~1.5 s on this laptop's
# CPU). Set RERANKER_ONNX_FILE empty to load torch weights instead; set
# RERANKER_MODEL=off to skip reranking.
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_ONNX_FILE=onnx/model_quantized.onnx

# Optional: Port configuration
PORT=8000
HOST=127.0.0.1
