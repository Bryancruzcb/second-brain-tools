{
  "manifest_version": 3,
  "name": "Second Brain Clipper",
  "version": "1.0",
  "description": "Clip selected text straight into your Obsidian Vault via Second Brain Tools",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
